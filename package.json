{
  "name": "vitamin-z-server",
  "version": "2.0.0",
  "description": "MCP server for Design System v1.2 \u2014 voice-command-optimized page scaffolding, token/component lookups, and DS code validation",
  "type": "module",
  "bin": {
    "vitamin-z": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "docs:build": "node docs/site/build-docs.mjs",
    "docs:serve": "node docs/site/serve.mjs",
    "verify": "node scripts/verify-ds.mjs",
    "smoke": "node scripts/smoke-tools.mjs",
    "test": "npm run build && npm run verify && npm run smoke",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:components": "node scripts/audit-components.mjs",
    "audit": "npm run audit:tokens && npm run audit:components"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "typescript": "^5.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}